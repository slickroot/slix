{
  "manifest_version": 3,
  "name": "slix",
  "version": "0.1.0",
  "description": "slix in the browser.",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["main.js", "fresh.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
